{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "theme_api",
    "id",
    "version",
    "license",
    "style",
    "mode",
    "schema_version",
    "package_type",
    "framework",
    "platforms",
    "architectures"
  ],
  "properties": {
    "theme_api": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "author": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "style": {
      "const": "style.css"
    },
    "mode": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "display_names": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "preview": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024,
      "pattern": "^assets/[A-Za-z0-9_./-]+\\.(png|jpg|jpeg|webp)$"
    },
    "settings": {
      "const": "settings.json"
    },
    "schema_version": {
      "const": 1
    },
    "descriptions": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "keywords": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "repository": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512,
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max_exclusive"
      ],
      "properties": {
        "min": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "max_exclusive": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "any",
          "windows",
          "linux",
          "macos"
        ]
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "any",
          "x86",
          "x86_64",
          "arm64"
        ]
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "release_id",
        "asset_id",
        "release",
        "url",
        "bytes",
        "sha256"
      ],
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "release_id": {
          "type": "integer",
          "minimum": 1
        },
        "asset_id": {
          "type": "integer",
          "minimum": 1
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[^\\s?#]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5368709120
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "package_type": {
      "const": "theme"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObliviousMic Theme Package Declaration v1"
}
