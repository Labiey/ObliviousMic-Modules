{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObliviousMic Module Package Declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_id",
    "module_version",
    "api",
    "runtime",
    "ports",
    "processing",
    "settings_schema",
    "actions_schema",
    "permissions",
    "resources",
    "schema_version",
    "package_type",
    "license",
    "framework",
    "platforms",
    "architectures"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "module_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max_exclusive"
      ],
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "max_exclusive": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entrypoint"
      ],
      "properties": {
        "kind": {
          "enum": [
            "python",
            "native",
            "process"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "worker": {
          "enum": [
            "python",
            "external"
          ]
        },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 10
        },
        "max_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "kind": {
                "enum": [
                  "audio",
                  "metadata",
                  "control"
                ]
              },
              "sample_rates": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "min",
                      "max"
                    ],
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                ]
              },
              "channels": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "min",
                      "max"
                    ],
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                ]
              },
              "sample_format": {
                "const": "f32_interleaved"
              },
              "schema_version": {
                "type": "integer",
                "minimum": 1
              },
              "optional": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "audio"
                    }
                  }
                },
                "then": {
                  "required": [
                    "sample_rates",
                    "channels",
                    "sample_format"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "metadata",
                        "control"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "schema_version"
                  ]
                }
              }
            ]
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "kind": {
                "enum": [
                  "audio",
                  "metadata",
                  "control"
                ]
              },
              "sample_rates": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "min",
                      "max"
                    ],
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                ]
              },
              "channels": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "min",
                      "max"
                    ],
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                ]
              },
              "sample_format": {
                "const": "f32_interleaved"
              },
              "schema_version": {
                "type": "integer",
                "minimum": 1
              },
              "optional": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "audio"
                    }
                  }
                },
                "then": {
                  "required": [
                    "sample_rates",
                    "channels",
                    "sample_format"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "metadata",
                        "control"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "schema_version"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_block_frames",
        "preferred_block_frames",
        "maximum_block_frames",
        "realtime_capable",
        "offline_capable",
        "stateful",
        "concurrent_process_calls",
        "max_tail_frames",
        "max_flush_calls",
        "latency_mode"
      ],
      "properties": {
        "minimum_block_frames": {
          "type": "integer",
          "minimum": 1
        },
        "preferred_block_frames": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_block_frames": {
          "type": "integer",
          "minimum": 1
        },
        "exact_block_frames": {
          "type": "integer",
          "minimum": 1
        },
        "max_flush_calls": {
          "type": "integer",
          "minimum": 1
        },
        "realtime_capable": {
          "type": "boolean"
        },
        "offline_capable": {
          "type": "boolean"
        },
        "stateful": {
          "type": "boolean"
        },
        "concurrent_process_calls": {
          "type": "boolean"
        },
        "allow_partial_eos": {
          "type": "boolean"
        },
        "max_tail_frames": {
          "type": "integer",
          "minimum": 0
        },
        "latency_mode": {
          "enum": [
            "fixed",
            "reported_on_prepare",
            "variable"
          ]
        },
        "async_process": {
          "type": "boolean"
        },
        "maximum_batch_packets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "description": "Maximum queued packets per input port in one asynchronous dispatch."
        },
        "deadline_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120,
          "description": "Bounded per-node processing deadline, including scheduler wait."
        },
        "maximum_output_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maximum_pending_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "settings_schema": {
      "type": "string",
      "minLength": 1
    },
    "actions_schema": {
      "type": "string",
      "minLength": 1
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_assets"
      ],
      "properties": {
        "model_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "display_names": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "author": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "descriptions": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "keywords": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "preview": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024,
      "pattern": "^assets/[A-Za-z0-9_./-]+\\.(png|jpg|jpeg|webp)$"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512,
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max_exclusive"
      ],
      "properties": {
        "min": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "max_exclusive": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "any",
          "windows",
          "linux",
          "macos"
        ]
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "any",
          "x86",
          "x86_64",
          "arm64"
        ]
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "release_id",
        "asset_id",
        "release",
        "url",
        "bytes",
        "sha256"
      ],
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "release_id": {
          "type": "integer",
          "minimum": 1
        },
        "asset_id": {
          "type": "integer",
          "minimum": 1
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[^\\s?#]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5368709120
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "package_type": {
      "const": "module"
    },
    "setup": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.json$"
    },
    "resource_declaration": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.json$"
    }
  }
}
