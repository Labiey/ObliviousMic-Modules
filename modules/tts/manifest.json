{
  "manifest_version": 1,
  "module_id": "org.obliviousmic.tts",
  "module_version": "1.0.0",
  "api": {
    "min": "1.0",
    "max_exclusive": "2.0"
  },
  "runtime": {
    "kind": "python",
    "entrypoint": "runtime:Module"
  },
  "ports": {
    "inputs": [
      {
        "id": "text",
        "kind": "metadata",
        "schema_version": 1,
        "optional": false
      }
    ],
    "outputs": [
      {
        "id": "audio",
        "kind": "audio",
        "sample_rates": [
          24000
        ],
        "channels": [
          1
        ],
        "sample_format": "f32_interleaved"
      },
      {
        "id": "text",
        "kind": "metadata",
        "schema_version": 1,
        "optional": false
      }
    ]
  },
  "processing": {
    "minimum_block_frames": 1,
    "preferred_block_frames": 160,
    "maximum_block_frames": 65536,
    "realtime_capable": true,
    "offline_capable": true,
    "stateful": true,
    "concurrent_process_calls": false,
    "max_tail_frames": 0,
    "max_flush_calls": 4,
    "latency_mode": "reported_on_prepare",
    "async_process": true,
    "maximum_batch_packets": 1,
    "deadline_seconds": 35,
    "maximum_output_frames": 960000
  },
  "settings_schema": "settings.schema.json",
  "actions_schema": "actions.schema.json",
  "permissions": [
    "profile.read",
    "service.acquire"
  ],
  "resources": {
    "model_assets": []
  },
  "dependencies": [
    "numpy>=2,<3",
    "soundfile>=0.13,<1",
    "soxr>=1.1,<2",
    "psutil>=5.9"
  ]
}
