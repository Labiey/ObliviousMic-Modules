{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "default": "qwen",
      "apply_policy": "hot",
      "enum": [
        "qwen",
        "azure"
      ],
      "enum_labels": {
        "qwen": {
          "zh-CN": "阿里云百炼",
          "en": "Alibaba Cloud Bailian",
          "ja": "Alibaba Cloud 百錬"
        },
        "azure": "Azure Speech"
      }
    },
    "language": {
      "type": "string",
      "default": "auto",
      "apply_policy": "hot",
      "enum": [
        "auto",
        "zh",
        "en",
        "ja"
      ]
    },
    "qwen_api_key": {
      "type": "string",
      "default": "",
      "apply_policy": "hot",
      "secret": true,
      "visible_when": {
        "provider": [
          "qwen"
        ]
      }
    },
    "qwen_region": {
      "type": "string",
      "default": "beijing",
      "apply_policy": "hot",
      "enum": [
        "beijing",
        "singapore"
      ],
      "visible_when": {
        "provider": [
          "qwen"
        ]
      }
    },
    "qwen_voice": {
      "type": "string",
      "default": "",
      "apply_policy": "hot",
      "visible_when": {
        "provider": [
          "qwen"
        ]
      }
    },
    "qwen_model": {
      "type": "string",
      "default": "qwen3-tts-flash",
      "apply_policy": "hot",
      "advanced": false,
      "visible_when": {
        "provider": [
          "qwen"
        ]
      }
    },
    "qwen_workspace_id": {
      "type": "string",
      "default": "",
      "apply_policy": "hot",
      "advanced": true,
      "visible_when": {
        "provider": [
          "qwen"
        ]
      }
    },
    "azure_api_key": {
      "type": "string",
      "default": "",
      "apply_policy": "hot",
      "secret": true,
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_region": {
      "type": "string",
      "default": "eastasia",
      "apply_policy": "hot",
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_voice": {
      "type": "string",
      "default": "",
      "apply_policy": "hot",
      "advanced": true,
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_rate": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.5,
      "maximum": 2.0,
      "ui_step": 0.01,
      "apply_policy": "hot",
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_pitch": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.5,
      "maximum": 2.0,
      "ui_step": 0.01,
      "apply_policy": "hot",
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_endpoint": {
      "type": "string",
      "default": "",
      "apply_policy": "hot",
      "advanced": true,
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "request_timeout_seconds": {
      "type": "integer",
      "default": 25,
      "apply_policy": "hot",
      "minimum": 2,
      "maximum": 30,
      "advanced": true
    },
    "maximum_audio_seconds": {
      "type": "integer",
      "default": 30,
      "apply_policy": "reprepare",
      "minimum": 1,
      "maximum": 40,
      "advanced": true
    },
    "maximum_text_characters": {
      "type": "integer",
      "default": 300,
      "apply_policy": "hot",
      "minimum": 1,
      "maximum": 1000,
      "advanced": true
    }
  }
}
