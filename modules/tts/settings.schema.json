{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "default": "gpt_sovits",
      "apply_policy": "reprepare",
      "enum": [
        "gpt_sovits",
        "qwen",
        "azure"
      ]
    },
    "language": {
      "type": "string",
      "default": "auto",
      "apply_policy": "reprepare",
      "enum": [
        "auto",
        "zh",
        "en",
        "ja"
      ]
    },
    "profile_id": {
      "type": "string",
      "default": "",
      "apply_policy": "reprepare",
      "format": "profile_id",
      "private": true,
      "visible_when": {
        "provider": [
          "gpt_sovits"
        ]
      }
    },
    "qwen_api_key": {
      "type": "string",
      "default": "",
      "apply_policy": "reprepare",
      "secret": true,
      "visible_when": {
        "provider": [
          "qwen"
        ]
      }
    },
    "qwen_region": {
      "type": "string",
      "default": "beijing",
      "apply_policy": "reprepare",
      "enum": [
        "beijing",
        "singapore"
      ],
      "visible_when": {
        "provider": [
          "qwen"
        ]
      }
    },
    "qwen_voice": {
      "type": "string",
      "default": "Cherry",
      "apply_policy": "reprepare",
      "visible_when": {
        "provider": [
          "qwen"
        ]
      }
    },
    "qwen_model": {
      "type": "string",
      "default": "qwen3-tts-flash",
      "apply_policy": "reprepare",
      "advanced": true,
      "visible_when": {
        "provider": [
          "qwen"
        ]
      }
    },
    "azure_api_key": {
      "type": "string",
      "default": "",
      "apply_policy": "reprepare",
      "secret": true,
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_region": {
      "type": "string",
      "default": "eastasia",
      "apply_policy": "reprepare",
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_voice": {
      "type": "string",
      "default": "",
      "apply_policy": "reprepare",
      "advanced": true,
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_rate": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.5,
      "maximum": 2.0,
      "ui_step": 0.01,
      "apply_policy": "reprepare",
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_pitch": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.5,
      "maximum": 2.0,
      "ui_step": 0.01,
      "apply_policy": "reprepare",
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_endpoint": {
      "type": "string",
      "default": "",
      "apply_policy": "reprepare",
      "advanced": true,
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "local_endpoint": {
      "type": "string",
      "default": "http://127.0.0.1:9880",
      "apply_policy": "reprepare",
      "advanced": true,
      "visible_when": {
        "provider": [
          "gpt_sovits"
        ]
      }
    },
    "local_install_directory": {
      "type": "string",
      "default": "",
      "apply_policy": "reprepare",
      "private": true,
      "advanced": true,
      "visible_when": {
        "provider": [
          "gpt_sovits"
        ]
      }
    },
    "auto_start_local": {
      "type": "boolean",
      "default": true,
      "apply_policy": "reprepare",
      "advanced": true,
      "visible_when": {
        "provider": [
          "gpt_sovits"
        ]
      }
    },
    "reference_path": {
      "type": "string",
      "default": "",
      "apply_policy": "reprepare",
      "private": true,
      "advanced": true,
      "visible_when": {
        "provider": [
          "gpt_sovits"
        ]
      }
    },
    "reference_prompt": {
      "type": "string",
      "default": "",
      "apply_policy": "reprepare",
      "private": true,
      "advanced": true,
      "visible_when": {
        "provider": [
          "gpt_sovits"
        ]
      }
    },
    "reference_language": {
      "type": "string",
      "default": "auto",
      "apply_policy": "reprepare",
      "enum": [
        "auto",
        "zh",
        "en",
        "ja"
      ],
      "advanced": true,
      "visible_when": {
        "provider": [
          "gpt_sovits"
        ]
      }
    },
    "request_timeout_seconds": {
      "type": "integer",
      "default": 25,
      "apply_policy": "reprepare",
      "minimum": 2,
      "maximum": 30,
      "advanced": true
    },
    "maximum_audio_seconds": {
      "type": "integer",
      "default": 30,
      "apply_policy": "reprepare",
      "minimum": 1,
      "maximum": 40,
      "advanced": true
    },
    "maximum_text_characters": {
      "type": "integer",
      "default": 300,
      "apply_policy": "reprepare",
      "minimum": 1,
      "maximum": 1000,
      "advanced": true
    }
  }
}
