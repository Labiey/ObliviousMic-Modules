{
  "manifest_version": 1,
  "module_id": "org.obliviousmic.broadcast",
  "module_version": "1.0.0",
  "api": {
    "min": "1.0",
    "max_exclusive": "2.0"
  },
  "runtime": {
    "kind": "python",
    "entrypoint": "runtime:Module"
  },
  "ports": {
    "inputs": [
      {
        "id": "audio",
        "kind": "audio",
        "sample_rates": [
          48000
        ],
        "channels": [
          1
        ],
        "sample_format": "f32_interleaved"
      }
    ],
    "outputs": [
      {
        "id": "audio",
        "kind": "audio",
        "sample_rates": [
          48000
        ],
        "channels": [
          1
        ],
        "sample_format": "f32_interleaved"
      }
    ]
  },
  "processing": {
    "minimum_block_frames": 1,
    "preferred_block_frames": 960,
    "maximum_block_frames": 48000,
    "realtime_capable": true,
    "offline_capable": true,
    "stateful": true,
    "concurrent_process_calls": false,
    "max_tail_frames": 600000,
    "max_flush_calls": 4,
    "latency_mode": "reported_on_prepare",
    "async_process": true,
    "maximum_batch_packets": 64,
    "deadline_seconds": 60,
    "maximum_output_frames": 600000,
    "maximum_pending_frames": 800000
  },
  "settings_schema": "settings.schema.json",
  "actions_schema": "actions.schema.json",
  "permissions": [],
  "resources": {
    "model_assets": []
  },
  "dependencies": [
    "numpy>=2,<3",
    "soundfile>=0.13,<1",
    "soxr>=1.1,<2"
  ]
}
