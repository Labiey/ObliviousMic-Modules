{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "default": "openai_compatible",
      "apply_policy": "reprepare",
      "enum": [
        "openai_compatible",
        "azure",
        "bailian"
      ],
      "enum_labels": {
        "openai_compatible": "OpenAI compatible",
        "azure": "Azure Speech",
        "bailian": {
          "zh-CN": "阿里云百炼",
          "en": "Alibaba Cloud Bailian",
          "ja": "Alibaba Cloud 百錬"
        }
      }
    },
    "base_url": {
      "type": "string",
      "default": "https://api.openai.com/v1",
      "apply_policy": "reprepare",
      "maxLength": 2048,
      "visible_when": {
        "provider": [
          "openai_compatible"
        ]
      }
    },
    "api_key": {
      "type": "string",
      "default": "",
      "apply_policy": "reprepare",
      "maxLength": 2048,
      "private": true,
      "secret": true,
      "visible_when": {
        "provider": [
          "openai_compatible"
        ]
      }
    },
    "model": {
      "type": "string",
      "default": "whisper-1",
      "apply_policy": "reprepare",
      "maxLength": 200,
      "visible_when": {
        "provider": [
          "openai_compatible"
        ]
      }
    },
    "language": {
      "type": "string",
      "default": "auto",
      "apply_policy": "reprepare",
      "enum": [
        "auto",
        "zh",
        "en",
        "ja"
      ],
      "visible_when": {
        "provider": [
          "openai_compatible",
          "bailian"
        ]
      }
    },
    "azure_api_key": {
      "type": "string",
      "default": "",
      "apply_policy": "reprepare",
      "maxLength": 2048,
      "private": true,
      "secret": true,
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_region": {
      "type": "string",
      "default": "eastasia",
      "apply_policy": "reprepare",
      "maxLength": 48,
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_language": {
      "type": "string",
      "default": "zh-CN",
      "apply_policy": "reprepare",
      "enum": [
        "zh-CN",
        "en-US",
        "ja-JP"
      ],
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "azure_endpoint": {
      "type": "string",
      "default": "",
      "apply_policy": "reprepare",
      "maxLength": 2048,
      "advanced": true,
      "visible_when": {
        "provider": [
          "azure"
        ]
      }
    },
    "bailian_api_key": {
      "type": "string",
      "default": "",
      "maxLength": 2048,
      "private": true,
      "secret": true,
      "apply_policy": "reprepare",
      "visible_when": {
        "provider": [
          "bailian"
        ]
      }
    },
    "bailian_region": {
      "type": "string",
      "default": "beijing",
      "enum": [
        "beijing",
        "singapore"
      ],
      "enum_labels": {
        "beijing": {
          "zh-CN": "北京",
          "en": "Beijing",
          "ja": "北京"
        },
        "singapore": {
          "zh-CN": "新加坡",
          "en": "Singapore",
          "ja": "シンガポール"
        }
      },
      "apply_policy": "reprepare",
      "visible_when": {
        "provider": [
          "bailian"
        ]
      }
    },
    "bailian_model": {
      "type": "string",
      "default": "qwen3-asr-flash",
      "maxLength": 200,
      "apply_policy": "reprepare",
      "visible_when": {
        "provider": [
          "bailian"
        ]
      }
    },
    "bailian_base_url": {
      "type": "string",
      "default": "",
      "maxLength": 2048,
      "advanced": true,
      "apply_policy": "reprepare",
      "visible_when": {
        "provider": [
          "bailian"
        ]
      }
    },
    "bailian_enable_itn": {
      "type": "boolean",
      "default": false,
      "advanced": true,
      "apply_policy": "reprepare",
      "visible_when": {
        "provider": [
          "bailian"
        ]
      }
    },
    "max_segment_seconds": {
      "type": "integer",
      "default": 6,
      "apply_policy": "reprepare",
      "minimum": 1,
      "maximum": 12,
      "advanced": true,
      "unit": "s"
    },
    "silence_ms": {
      "type": "integer",
      "default": 500,
      "apply_policy": "reprepare",
      "minimum": 100,
      "maximum": 2000,
      "advanced": true,
      "unit": "ms"
    },
    "minimum_speech_ms": {
      "type": "integer",
      "default": 200,
      "apply_policy": "reprepare",
      "minimum": 50,
      "maximum": 1000,
      "advanced": true,
      "unit": "ms"
    },
    "silence_dbfs": {
      "type": "number",
      "default": -48,
      "apply_policy": "reprepare",
      "minimum": -80,
      "maximum": -15,
      "advanced": true,
      "unit": "dBFS"
    },
    "request_timeout_seconds": {
      "type": "integer",
      "default": 15,
      "apply_policy": "reprepare",
      "minimum": 2,
      "maximum": 30,
      "advanced": true,
      "unit": "s"
    }
  }
}
